{
  "name": "@workspace/api-server",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "orderly:dry-run": "esbuild src/services/orderly/bayHillOrderlyDryRun.ts --bundle --platform=node --format=esm --outfile=dist/orderly-dry-run.mjs && node --enable-source-maps dist/orderly-dry-run.mjs",
    "orderly:adoption-preview": "esbuild src/services/orderly/orderlyVendorProductAdoptionPreviewCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-adoption-preview.mjs && node --enable-source-maps dist/orderly-adoption-preview.mjs",
    "orderly:adoption-apply": "esbuild src/services/orderly/orderlyVendorProductAdoptionApplyCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-adoption-apply.mjs && node --enable-source-maps dist/orderly-adoption-apply.mjs",
    "orderly:adoption-post-apply-verify": "esbuild src/services/orderly/orderlyVendorProductAdoptionPostApplyVerificationCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-adoption-post-apply-verify.mjs && node --enable-source-maps dist/orderly-adoption-post-apply-verify.mjs",
    "orderly:adoption-idempotency": "esbuild src/services/orderly/orderlyVendorProductAdoptionIdempotencyCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-adoption-idempotency.mjs && node --enable-source-maps dist/orderly-adoption-idempotency.mjs",
    "orderly:active-status-overlay": "esbuild src/services/orderly/orderlyVendorProductActiveStatusOverlayCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-active-status-overlay.mjs && node --enable-source-maps dist/orderly-active-status-overlay.mjs",
    "orderly:may-backfill": "esbuild src/services/orderly/mayHistoricalSessionBackfillCli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/orderly-may-backfill.mjs && node --enable-source-maps dist/orderly-may-backfill.mjs",
    "orderly:remediate": "pnpm run build && node --enable-source-maps ./dist/services/orderly/bayHillDuplicateRemediationCli.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@neondatabase/serverless": "^1.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express-session": "^1.19.0",
    "@types/memoizee": "^0.4.12",
    "@types/multer": "^2.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "autocannon": "^8.0.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.10.1",
    "heic-convert": "^2.1.0",
    "intuit-oauth": "^4.2.5",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "memoizee": "^0.4.17",
    "memorystore": "^1.6.8",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.4",
    "openai": "^7.4.0",
    "openapi-types": "^12.1.3",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.3",
    "stripe": "^22.4.0",
    "supertest": "^7.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.21.2",
    "xlsx": "^0.18.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.10"
  }
}
